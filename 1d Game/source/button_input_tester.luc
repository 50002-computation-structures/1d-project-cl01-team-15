module button_input_tester (
    input clk,
    input rst,
    input btn[5],
    input dips[3][8],         // Use some DIP switches as mock inputs
    output io_led[3][8]
) {
    sig all_buttons[18];      // 18 total inputs (9 per player)
    sig position[4];
    sig valid;
    sig player;



    button_input_handler input_handler(
        .clk(clk), .rst(rst),
        .btns(all_buttons),
        .player(player)
    );
    dff current_button[4] (.clk(clk), .rst(rst), #INIT(4x{0}))

    always {
        io_led = 3x{{8b0}}
            // DIP switch 0 selects player
    player = dips[0][0];

    // Map player 0 buttons (first 5 are real)
    all_buttons[0] = btn[0];
    all_buttons[1] = btn[1];
    all_buttons[2] = btn[2];
    all_buttons[3] = btn[3];
    all_buttons[4] = btn[4];
    all_buttons[5] = dips[0][1];
    all_buttons[6] = dips[0][2];
    all_buttons[7] = dips[0][3];
    all_buttons[8] = dips[0][4];

    // Simulate player 1 buttons with DIP switches
    all_buttons[9]  = dips[1][0];
    all_buttons[10] = dips[1][1];
    all_buttons[11] = dips[1][2];
    all_buttons[12] = dips[1][3];
    all_buttons[13] = dips[2][0];
    all_buttons[14] = dips[2][1];
    all_buttons[15] = dips[2][2];
    all_buttons[16] = dips[2][3];
    all_buttons[17] = dips[0][5];
        valid = input_handler.valid
        position = input_handler.position
        // Show pressed button index on first row of LEDs
        if (valid) {
            current_button.d = position
        }
        io_led[0][0] = current_button.q[0]
            io_led[0][1] = current_button.q[1]
            io_led[0][2] = current_button.q[2];
            io_led[0][3] = current_button.q[3]
    }
}
