module game_datapath#(
    SLOW_CLOCK_DIV ~ 26 : SLOW_CLOCK_DIV > 0,
    FAST_CLOCK_DIV ~ 21 : FAST_CLOCK_DIV > 0,
    BOOLEAN_CLOCK_DIV ~ 14 : BOOLEAN_CLOCK_DIV > 0
)(
    input button_isPressed,
    input button_number[4],
    
    input clk,  // clock
    input rst,  // reset
    
    // output to LEDs/7segments
    output current_button_out[32],
    output current_round_out[32],
    output current_player_out[32],
    output current_timer_out[32],
    output current_attempts_out[32],
    output current_light_out[32],
    output slow_clock_out,
    output display_clock_out,
        
    // debug signals
    output debug_general[32],
    output current_state[6]
) {
    
    //temp variables
    sig input_alu_a[32]
    sig input_alu_b[32]
    sig bool_sig
    sig current_player_sig[32]
    
    alu game_alu
    
    
    .clk(clk){
        counter game_timer_clock(#SIZE(1),#DIV(SLOW_CLOCK_DIV), .rst(rst)) 
        counter game_display_timer(#SIZE(1),#DIV(FAST_CLOCK_DIV), .rst(rst))
        counter boolean_timer(#SIZE(1),#DIV(BOOLEAN_CLOCK_DIV), .rst(rst))
        
        // edge detector declaration & connection with counters
        edge_detector edge_detector_game_timer(#RISE(1), #FALL(0), .in(game_timer_clock.value))
        edge_detector edge_detector_display_timer(#RISE(1), #FALL(0), .in(game_display_timer.value))
        edge_detector edge_detector_boolean_timer(#RISE(1), #FALL(0), .in(boolean_timer.value))
        edge_detector button_edge(#RISE(1), #FALL(0), .in(button_isPressed))
        
        
        
        game_cu game_cu(
            .rst(rst),
            .button_press(button_edge.out),
            .decrease_timer(edge_detector_game_timer.out),
            .display_timer(edge_detector_display_timer.out),
            .bool_timer(boolean_timer.value),
 //           .bool(bool_sig),
            .current_player(current_player_sig)
            
        )
        
        game_regfiles game_regfiles(
            .we(game_cu.regfile_we), 
            .wa(game_cu.regfile_wa), 
            .ra1(game_cu.regfile_ra1), 
            .ra2(game_cu.regfile_ra2),
            .rst(rst)
        )
    }
    always {
        
        bool_sig = game_regfiles.boolean_out[0]
        current_player_sig = game_regfiles.current_player_out
        
        game_cu.bool = bool_sig
        
        // asel mux
        case(game_cu.asel){
            b00  : input_alu_a = game_regfiles.rd1
            b01  : input_alu_a = 8h0 
            b10  : input_alu_a = 8h8
            b11  : input_alu_a = 8h4
            default : //b10 unused
                input_alu_a = 0
        }
        
        // bsel mux
        case(game_cu.bsel){
            b00 : input_alu_b = game_regfiles.rd2
            b01 : input_alu_b = 8hF
            b10 : input_alu_b = 8h1
            b11 : input_alu_b = 8hA
            b100: input_alu_b = 8h4
            b101: input_alu_b = 8h0
            default: //necessary to init
                input_alu_b = 0
            
        }
        
        // alu
        game_alu.a = input_alu_a
        game_alu.b = input_alu_b
        game_alu.alufn = game_cu.alufn
        
        // wdsel mux
        case (game_cu.alu_out_sel){
            b01 : game_regfiles.data = h0
            b10 : game_regfiles.data = hA
            b11 : game_regfiles.data = button_number
            b100: game_regfiles.data = h1
            b101: game_regfiles.data = h2
            b110: game_regfiles.data = h7
            b111: game_regfiles.data = hB
            default : 
                game_regfiles.data = game_alu.out
        }
        
        //current_button_out = game_regfiles.current_button_light_out
        current_button_out = game_regfiles.user_input_out
        current_round_out = game_regfiles.current_round_out
        current_player_out = game_regfiles.current_player_out
        current_timer_out = game_regfiles.timer_out
        slow_clock_out = game_timer_clock.value
        display_clock_out = game_display_timer.value
        current_attempts_out =game_regfiles.attempts_out
        current_light_out = game_regfiles.current_button_light_out
        
        
        debug_general = game_regfiles.debug
        current_state = game_cu.debug
    }
}